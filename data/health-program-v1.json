      "requiredSignals": [
        "Fast feedback",
        "Deep Audit Governance",
        "MouldMaster Domain Foundation QA",
        "Frozen Recovery Contract",
        "Release External Validation Boundary"
      ]
    },
    "deepReleaseTier": {
      "intent": "Browser, release, PWA, desktop and maturity integration coverage.",
      "requiredSignals": [
        "MouldMaster Release QA",
        "MouldMaster Pages Release Readiness",
        "Mobile Browser QA",
        "Premium UI QA",
        "Open Desktop Build",
        "Production Observability QA",
        "MouldMaster Physical PWA Contract QA",
        "Question Quality 50-Pass",
        "Read Aloud QA"
      ]
    },
    "criticalPaths": [
      {
        "id": "backup-import",
        "risk": "learner-data-corruption",
        "regressions": [
          "src/core-runtime/core-inline-007.js",
          "training-qa-fix.js",
          "src/domains/learning/backup-authority-notice.js",
          "qa_learner_backup_integrity.cjs",
          "tools/health_restore_drill.py"
        ],
        "tier": "deep-release"
      },
      {
        "id": "process-data-numerics",
        "risk": "silent-engineering-miscalculation",
        "regressions": [
          "qa_process_statistics_domain.mjs",
          "qa_engineering_domain.mjs",
          "qa_data_integration.py"
        ],
