      },
      {
        "id": "process-data-delete",
        "risk": "privacy-reset-incomplete",
        "regressions": [
          "data-integration-runtime.js",
          "src/domains/process/process-data-integrity.js"
        ],
        "tier": "fast-pr"
      },
      {
        "id": "release-fingerprint",
        "risk": "evidence-bound-to-wrong-bytes",
        "regressions": [
          "tools/verify_release_external_validation.py",
          "tools/verify_pwa_physical_evidence.py"
        ],
        "tier": "fast-pr"
      },
      {
        "id": "offline-pwa",
        "risk": "mixed-or-unavailable-runtime",
        "regressions": [
