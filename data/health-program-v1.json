{
  "schemaVersion": 1,
  "program": "mouldmaster-long-term-health",
  "currentWebRelease": "2026.09.24.5",
  "principles": {
    "protectedMainRequired": true,
    "failClosedEngineering": true,
    "externalHoldsAreNotDefects": true,
    "productionAuthority": "advisory-only",
    "automaticMachineControl": false
  },
  "ci": {
    "failureClasses": [
      "product-regression",
      "infrastructure-failure",
      "external-evidence-hold"
