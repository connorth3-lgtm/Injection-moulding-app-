    "historicalDefectRegressions": [
      281,
      282,
      283,
      285,
      288,
      300,
      311
    ]
  },
  "persistence": {
    "stores": [
      {
        "id": "learner-core",
        "technology": "localStorage",
        "identity": "mouldmasterProDB",
        "source": "src/core-runtime/core-inline-007.js",
        "sourceOfTruth": true,
        "backupScope": "learner-core-backup",
        "deletionBoundary": "learner-reset"
      },
      {
        "id": "learner-scoped-extras",
        "technology": "localStorage",
        "identity": "learner-scoped keys registered through MM_LEARNER_SCOPE",
        "source": "src/domains/shared/learner-scope.js",
        "sourceOfTruth": true,
        "backupScope": "explicit-per-feature",
        "deletionBoundary": "learner-reset"
      },
      {
        "id": "engineering-cases",
        "technology": "IndexedDB",
        "identity": "mouldmaster-engineering-v2",
        "version": 2,
        "stores": [
          "cases",
          "caseLinks",
          "migrations"
        ],
        "source": "src/domains/engineering/engineering-store.js",
        "sourceOfTruth": true,
        "legacySource": "mm_mould_master_cases_v1::<learner-token>",
        "migration": "additive-non-destructive-idempotent",
        "deletionBoundary": "engineering-evidence"
      },
      {
        "id": "process-data",
        "technology": "IndexedDB",
        "identity": "mouldmaster-process-data-v1",
        "version": 1,
        "stores": [
          "datasets",
          "shots",
          "baselines",
          "caseLinks",
          "interventions"
        ],
        "source": "data-integration-runtime.js",
        "sourceOfTruth": true,
        "backupScope": "site-local-explicit-export-only",
        "deletionBoundary": "process-data-reset"
      },
      {
        "id": "production-health",
        "technology": "localStorage",
        "identity": "mm_production_health_v1",
        "version": 1,
        "source": "production-health.js",
        "sourceOfTruth": false,
        "rebuildable": true,
        "retentionMaxEvents": 120,
        "deletionBoundary": "diagnostics-clear"
      }
    ],
    "learnerBackupContract": {
      "format": "mouldmaster-backup-v3",
      "payloadFormat": "mouldmaster-backup-v2",
      "maxBytes": 10485760,
      "maxLearners": 500,
      "strictLearnerId": true,
      "unknownTopLevelPropertiesAccepted": false,
      "commitAfterFullValidation": true,
      "failurePreservesExistingData": true,
      "integrity": {
        "algorithm": "SHA-256",
        "canonicalization": "json-stable-v1",
        "scope": "backupFormat+payload",
        "verifiedBeforeRestore": true,
        "detectsCorruptionOrModification": true,
        "provesAuthenticity": false
      },
      "legacyCompatibility": {
        "format": "mouldmaster-backup-v2",
        "integrityStatus": "unverified",
        "requiresExplicitUserDisclosure": true,
        "usesExistingStrictImporter": true
      }
    },
    "migrationRules": [
      "validate-before-write",
      "verify-current-backup-integrity-before-restore",
      "preserve-last-known-good-on-failure",
      "idempotent-where-replayed",
      "never-conflate-learner-reset-with-process-evidence-delete",
      "derived-data-may-be-rebuilt-but-source-data-must-not-be-silently-replaced"
    ]
  },
  "observability": {
    "eventSchema": "production-health-v1",
    "eventLimit": 120,
    "privacy": "local-only-no-raw-learner-or-process-values",
    "stableClasses": {
      "ok": [
        "deployment_ok",
        "online"
      ],
      "degraded": [
        "offline",
        "resource_error",
        "deployment_unreachable"
      ],
      "failed": [
        "runtime_error",
        "promise_error",
        "deployment_mismatch",
        "sw_redundant"
      ],
      "blocked": [
        "external-evidence-hold"
      ]
    },
    "stuckRule": "A governed workflow is stuck only when it violates its canonical lifecycle/timeout rule; an explicit HOLD awaiting external evidence is not stuck."
  },
  "operations": {
    "lanes": [
      {
        "id": "web-pwa",
        "releaseChecks": [
          "MouldMaster Release QA",
          "MouldMaster Pages Release Readiness",
          "Release External Validation Boundary"
        ],
        "rollback": "redeploy a previously retained exact Pages artifact through protected release procedure"
      },
      {
        "id": "open-desktop",
        "releaseChecks": [
          "Open Desktop Build"
        ],
        "rollback": "return to a previously hashed desktop artifact/release; do not mutate a governed release"
      },
      {
        "id": "frozen-recovery",
        "releaseChecks": [
          "Frozen Recovery Contract"
        ],
        "rollback": "use only the immutable commit-and-hash-pinned recovery chain"
      }
    ],
    "incidentClasses": [
      "runtime-defect",
      "data-corruption",
      "ci-infrastructure",
      "release-integrity",
      "governance-evidence-hold"
    ],
    "stopConditions": [
      "release-fingerprint-mismatch",
      "unverified-data-restore",
      "critical-security-integrity-failure",
      "governance-state-contradiction"
    ]
  },
  "maintenance": {
    "supportedAutomationBaseline": {
      "node": "22",
      "python": "3.12"
    },
    "cadenceDays": {
      "dependencyReview": 30,
      "securityReview": 30,
      "backupRestoreDrill": 90,
      "releaseRecoveryDrill": 90,
      "healthReview": 30
    },
    "vulnerabilityTriage": {
      "critical": "immediate-hold-and-remediate",
      "high": "prioritize-next-protected-change",
      "medium": "schedule-and-track",
      "low": "review-at-maintenance-cycle"
    },
    "exceptions": {
      "mustHaveOwner": true,
      "mustHaveExpiry": true,
      "mustNotDisableRequiredGates": true
    }
  },
  "indicators": [
    {
      "id": "required-pr-gates",
      "healthy": "all required gates successful",
      "failure": "any required product gate red"
    },
    {
      "id": "flaky-required-gates",
      "healthy": "0 accepted flaky required gates",
      "failure": "flakiness normalized instead of repaired or isolated"
    },
    {
      "id": "critical-defects",
      "healthy": "0 unresolved critical correctness/security defects",
      "failure": "critical defect left without explicit HOLD/owner"
    },
    {
      "id": "backup-restore-recency",
      "healthy": "drill age <= 90 days",
      "failure": "drill overdue"
    },
    {
      "id": "release-recovery-recency",
      "healthy": "drill age <= 90 days",
      "failure": "drill overdue"
    },
    {
      "id": "stuck-orphan",
      "healthy": "0 canonical stuck/orphan workflows",
      "failure": "unexplained stuck/orphan state exists"
    },
    {
      "id": "external-validation",
      "healthy": "reported truthfully as PASS or HOLD",
      "failure": "HOLD omitted, relabelled or treated as software pass"
    }
  ],
  "baselineReview": {
