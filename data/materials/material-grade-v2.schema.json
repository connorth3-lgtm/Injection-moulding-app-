{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mouldmaster.local/schema/material-grade-v2.json",
  "title": "MouldMaster exact commercial material grade v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "manufacturer", "grade", "polymer", "lifecycle", "sources", "provenance"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^mat-[a-z0-9][a-z0-9._-]{2,95}$"},
    "manufacturer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^mfr-[a-z0-9][a-z0-9._-]{1,63}$"},
        "name": {"type": "string", "minLength": 2, "maxLength": 160},
        "country": {"type": ["string", "null"], "maxLength": 80}
      }
    },
    "brand": {"type": ["string", "null"], "maxLength": 120},
    "grade": {"type": "string", "minLength": 1, "maxLength": 160},
    "aliases": {"type": "array", "items": {"type": "string", "maxLength": 160}, "uniqueItems": true},
    "polymer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": {
        "family": {"type": "string", "minLength": 1, "maxLength": 80},
        "blend": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variantId": {"type": ["string", "null"], "maxLength": 120},
        "regionalVariant": {"type": ["string", "null"], "maxLength": 120},
        "formulationRevision": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "properties": {"type": "array", "items": {"$ref": "#/$defs/propertyObservation"}},
    "processing": {"type": "array", "items": {"$ref": "#/$defs/processingObservation"}},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["active", "restricted", "superseded", "discontinued", "unknown"]},
        "checkedAt": {"type": ["string", "null"], "format": "date"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceDocument"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage"],
      "properties": {
        "stage": {"enum": ["staging", "source-reviewed-staging", "validated", "published"]},
        "reviewedAt": {"type": ["string", "null"], "format": "date-time"},
        "reviewer": {"type": ["string", "null"], "maxLength": 120},
        "notes": {"type": ["string", "null"], "maxLength": 800}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"provenance": {"properties": {"stage": {"enum": ["validated", "published"]}}}},
        "required": ["provenance"]
      },
      "then": {
        "properties": {
          "sources": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/sourceDocument"},
                {"required": ["revision", "fingerprint"]}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publisher", "title", "url", "kind", "retrievedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^src-[a-z0-9][a-z0-9._-]{2,95}$"},
        "publisher": {"type": "string", "minLength": 2, "maxLength": 160},
        "title": {"type": "string", "minLength": 2, "maxLength": 300},
        "url": {"type": "string", "format": "uri"},
        "kind": {"enum": ["manufacturer-datasheet", "manufacturer-processing-guide", "manufacturer-certificate", "regulatory", "standard", "research", "other"]},
        "revision": {"type": "string", "minLength": 1, "maxLength": 160},
        "documentDate": {"type": ["string", "null"], "format": "date"},
        "retrievedAt": {"type": "string", "format": "date"},
        "fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "quantity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "unit"],
          "properties": {
            "kind": {"const": "scalar"},
            "value": {"type": "number"},
            "unit": {"type": "string", "minLength": 1, "maxLength": 40}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "min", "max", "unit"],
          "properties": {
            "kind": {"const": "range"},
            "min": {"type": "number"},
            "max": {"type": "number"},
            "typical": {"type": ["number", "null"]},
            "unit": {"type": "string", "minLength": 1, "maxLength": 40}
          }
        }
      ]
    },
    "testContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {"type": ["string", "null"], "maxLength": 120},
        "temperatureC": {"type": ["number", "null"]},
        "loadKg": {"type": ["number", "null"], "minimum": 0},
        "specimen": {"type": ["string", "null"], "maxLength": 180},
        "conditioning": {"type": ["string", "null"], "maxLength": 180},
        "direction": {"enum": ["flow", "transverse", "isotropic", "not-applicable", "unknown"]}
      }
    },
    "propertyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "propertyKey", "label", "quantity", "sourceId", "semanticStatus"],
      "properties": {
        "id": {"type": "string", "pattern": "^obs-[a-z0-9][a-z0-9._-]{2,95}$"},
        "propertyKey": {"enum": ["density", "melt_flow_rate", "tensile_strength", "tensile_modulus", "flexural_strength", "flexural_modulus", "notched_izod_impact", "mould_shrinkage", "other"]},
        "label": {"type": "string", "minLength": 2, "maxLength": 100},
        "quantity": {"$ref": "#/$defs/quantity"},
        "test": {"$ref": "#/$defs/testContext"},
        "sourceId": {"type": "string", "minLength": 3, "maxLength": 120},
        "sourcePage": {"type": ["string", "null"], "maxLength": 40},
        "semanticStatus": {"enum": ["complete", "context-only"]},
        "limitations": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "processingObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameterKey", "label", "quantity", "sourceId", "claimType", "productionRecipe"],
      "properties": {
        "id": {"type": "string", "pattern": "^proc-[a-z0-9][a-z0-9._-]{2,95}$"},
        "parameterKey": {"enum": ["drying_temperature", "drying_time", "melt_temperature", "mould_temperature", "maximum_moisture", "other"]},
        "label": {"type": "string", "minLength": 2, "maxLength": 100},
        "quantity": {"$ref": "#/$defs/quantity"},
        "condition": {"type": ["string", "null"], "maxLength": 300},
        "claimType": {"enum": ["supplier-guidance", "supplier-limit", "site-validated", "study-observation", "unknown"]},
        "sourceId": {"type": "string", "minLength": 3, "maxLength": 120},
        "sourcePage": {"type": ["string", "null"], "maxLength": 40},
        "productionRecipe": {"const": false}
      }
    }
  }
}
