      "description": "Open sourced exact-grade details and understand property/process evidence boundaries."
    },
    {
      "id": "assessment-announcements",
      "description": "Complete core learner assessment interactions and confirm state/errors are announced meaningfully."
    },
    {
      "id": "evidence-case",
      "description": "Create or edit a Mould Master evidence case without losing semantic context."
    },
    {
      "id": "book-search-deep-chapter",
      "description": "Search for a Book topic from the global search, open a late Book chapter from deep in the contents, confirm focus/reading starts at the chapter heading, then return to contents without losing the reader's place."
    },
    {
      "id": "book-disclosures",
      "description": "Exercise the collapsed Book publication/review and accuracy/assurance disclosures; confirm their summaries, expanded content and independent-SME HOLD remain understandable without excessive verbosity."
    },
    {
      "id": "interactive-controls",
      "description": "Exercise dialogs, menus, tab-like controls, expandable regions and form validation with keyboard/AT navigation."
    },
    {
      "id": "status-announcements",
      "description": "Confirm status changes that matter to task completion are announced without forcing excessive verbosity."
    },
    {
      "id": "structure-zoom-focus",
      "description": "Confirm headings, landmarks, accessible names and focus order remain understandable at realistic zoom/text settings, including the Home page hierarchy where Today's focus precedes the secondary Workbench and the compact desktop More-tools navigation where applicable."
    },
    {
      "id": "standards-readiness",
      "description": "Open Standards & readiness and confirm ISO/NZQA boundaries, current-vs-expired standards, and external HOLD language remain understandable without implying certification, approval or competence."
    },
    {
      "id": "book-worked-examples",
      "description": "In affected Book chapters, navigate the worked-example heading, data table/list content, calculation steps, boundaries and evidence anchors; confirm the synthetic-data and independent-SME-HOLD wording is understandable with the named real assistive technology."
    }
