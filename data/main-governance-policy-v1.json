{
  "schemaVersion": 1,
  "policyId": "mouldmaster-main-governance-policy",
  "version": "2026.10.07.solo1",
  "targetRef": "refs/heads/main",
  "enforcement": "active",
  "bypassActors": [],
  "pullRequest": {
    "minimumApprovals": 0,
    "independentReviewerRequired": false,
    "dismissStaleReviews": false,
    "latestHeadApproval": false,
    "reviewThreadResolution": true,
    "extraApprovalForUnattributedChanges": false,
    "allowedMergeMethods": [
      "squash"
    ]
  },
  "requiredStatusChecks": {
    "strict": true,
    "enforceOnCreate": true,
    "integrationId": 15368,
    "contexts": [
      "integrity",
      "mobile-browser",
      "build-windows",
      "question-quality-50-pass",
      "release-external-validation",
      "exact-head-risk-coverage"
    ]
  },
  "security": {
    "codeScanning": {
      "tool": "CodeQL",
      "securityAlertsThreshold": "medium_or_higher",
      "alertsThreshold": "all"
    },
    "codeQualitySeverity": "all",
    "copilotReviewOnPush": true,
    "copilotReviewDraftPullRequests": true
  },
  "branchHistory": {
    "linearHistoryRequired": true,
    "deletionBlocked": true,
    "nonFastForwardBlocked": true
  },
  "exitCondition": "Live main-only, no-bypass ruleset matches this policy, all six automated security/release checks pass on the exact PR head, and ownerLogin manually authorizes the squash merge. External validation remains a separate HOLD unless genuine evidence exists.",
  "maintainerMode": "solo",
  "soloMaintainer": {
    "ownerLogin": "connorth3-lgtm",
    "releaseDecision": "Owner reviews exact-head CI and explicitly performs the GitHub squash merge; merged_by must match ownerLogin.",
    "humanIndependentCodeApprovalRequired": false
  }
}
