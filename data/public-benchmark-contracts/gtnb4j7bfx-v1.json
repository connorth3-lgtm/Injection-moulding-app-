    {"name":"Total_Production","unit":"units","class":"production_count","share_action":"keep","command_actual":"not_applicable"},
    {"name":"Avg_Gross_Weight","unit":"g","class":"quality_measurement","share_action":"keep","command_actual":"measured_or_derived_unknown"},
    {"name":"PP_Consumption","unit":"kg","class":"material_consumption","share_action":"keep","command_actual":"measured_or_derived_unknown"},
    {"name":"Pigment_Consumption","unit":"kg","class":"material_consumption","share_action":"keep","command_actual":"measured_or_derived_unknown"},
    {"name":"Flash_kg","unit":"kg","class":"quality_outcome","share_action":"keep","command_actual":"measured_or_derived_unknown"},
    {"name":"Defective_kg","unit":"kg","class":"quality_outcome","share_action":"keep","command_actual":"measured_or_derived_unknown"},
    {"name":"%Flash","unit":"%","class":"derived_quality_metric","share_action":"keep","command_actual":"derived"},
    {"name":"%Defective","unit":"%","class":"derived_quality_metric","share_action":"keep","command_actual":"derived"},
