    "published": "2025-08-05",
    "context": "industrial injection- and blow-moulding operations"
  },
  "source_article": {
    "title": "Enhancement of Operational Efficiency in a Plastic Manufacturing Industry Through TPM, SMED, and Machine Learning—Case Study",
    "doi": "10.3390/su17167445",
    "role": "associated peer-reviewed variable/methodology source"
  },
  "benchmark_scope": {
    "required_process_context": "injection-moulding",
    "record_resolution": "production-order/run-level unless the downloaded file proves finer resolution",
    "separation_rule": "Injection- and blow-moulding records must remain separate.",
    "site_pilot_status": "External public benchmark only; not authorised-site pilot evidence."
  },
  "preprocessing_guardrails": [
    "Preserve missing values as missing; do not reproduce the source study's null-to-zero preprocessing by default.",
    "Do not infer shot resolution, cavity trace alignment, intervention timing or recovery evidence unless the downloaded file proves them.",
    "Do not treat historical pressure, temperature, time or speed values as recommended setpoints or validated production limits.",
    "Do not label reject, flash, defective or reprocess correlations as root causes without independent discriminating evidence.",
    "Keep machine/product/date identifiers out of shareable derived reports unless needed, licensed and appropriately governed.",
    "Commanded/target versus actual semantics are unknown for process variables unless the downloaded file or associated documentation explicitly establishes them."
  ],
  "columns": [
    {"name":"Date_Recorded","unit":"YYYY-MM-DD","class":"timestamp_metadata","share_action":"drop","command_actual":"not_applicable"},
    {"name":"Machine","unit":null,"class":"operational_identifier","share_action":"alias","command_actual":"not_applicable"},
    {"name":"Shift","unit":"index","class":"grouping_context","share_action":"keep","command_actual":"not_applicable"},
    {"name":"Product_Name","unit":null,"class":"operational_identifier","share_action":"alias","command_actual":"not_applicable"},
    {"name":"Product_Weight","unit":"g","class":"product_record","share_action":"keep","command_actual":"unknown_source_semantics"},
    {"name":"Required_Production","unit":"units","class":"production_target","share_action":"keep","command_actual":"target"},
