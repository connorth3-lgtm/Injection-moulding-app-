{
  "name": "mouldmaster-academy-desktop",
  "version": "2026.8.25",
  "description": "Open-source Windows desktop wrapper for MouldMaster Academy.",
  "author": "MouldMaster Academy contributors",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "integrity": "node scripts/generate-integrity.cjs",
    "licenses": "node scripts/generate-licenses.cjs",
    "sbom": "node scripts/generate-sbom.cjs",
    "qa": "node scripts/qa.cjs",
    "start": "npm run integrity && npm run licenses && npm run sbom && npm run qa && electron .",
    "dist:portable": "npm run integrity && npm run licenses && npm run sbom && npm run qa && electron-builder --win portable",
    "dist:nsis": "npm run integrity && npm run licenses && npm run sbom && npm run qa && electron-builder --win nsis",
    "dist:msix": "npm run integrity && npm run licenses && npm run sbom && npm run qa && npx --yes electron-builder@27.0.0-alpha.7 --win msix --config.msix.setBuildNumber=true"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "org.mouldmaster.academy",
    "productName": "MouldMaster Academy",
    "buildNumber": "1",
    "buildVersion": "2026.8.25.1",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {"output": "dist"},
    "files": [
      "src/**/*",
      "generated/integrity.json",
      "generated/dependency-licenses.json",
      "generated/sbom.cdx.json",
      "package.json",
      "README.md",
      "THREAT_MODEL.md"
    ],
    "extraResources": [
      {"from": "../../index.html", "to": "mouldmaster/index.html"},
      {"from": "../../MouldMaster_Core_App.html", "to": "mouldmaster/MouldMaster_Core_App.html"},
      {"from": "../../MouldMaster_Academy_App.html", "to": "mouldmaster/MouldMaster_Academy_App.html"},
      {"from": "../../manifest.webmanifest", "to": "mouldmaster/manifest.webmanifest"},
      {"from": "../../mouldmaster-192.png", "to": "mouldmaster/mouldmaster-192.png"},
      {"from": "../../mouldmaster-512.png", "to": "mouldmaster/mouldmaster-512.png"},
      {"from": "../../version.json", "to": "mouldmaster/version.json"},
      {"from": "../../reading-patch.css", "to": "mouldmaster/reading-patch.css"},
      {"from": "../../reading-patch.js", "to": "mouldmaster/reading-patch.js"},
      {"from": "../../training-upgrade.js", "to": "mouldmaster/training-upgrade.js"},
      {"from": "../../training-qa-fix.js", "to": "mouldmaster/training-qa-fix.js"},
      {"from": "../../assessment-100-pass.js", "to": "mouldmaster/assessment-100-pass.js"},
      {"from": "../../assessment-deep-dive.js", "to": "mouldmaster/assessment-deep-dive.js"},
      {"from": "../../assessment-answer-cue-fix.js", "to": "mouldmaster/assessment-answer-cue-fix.js"},
      {"from": "../../assessment-storage-scope.js", "to": "mouldmaster/assessment-storage-scope.js"},
      {"from": "../../assessment-quality-suite.js", "to": "mouldmaster/assessment-quality-suite.js"},
      {"from": "../../assessment-stable-review-bridge.js", "to": "mouldmaster/assessment-stable-review-bridge.js"},
      {"from": "../../assessment-analytics-ui.js", "to": "mouldmaster/assessment-analytics-ui.js"},
      {"from": "../../assessment-final-hardening.js", "to": "mouldmaster/assessment-final-hardening.js"},
      {"from": "../../assessment-ux.js", "to": "mouldmaster/assessment-ux.js"},
      {"from": "../../pwa-shell.js", "to": "mouldmaster/pwa-shell.js"},
      {"from": "../../source-library.js", "to": "mouldmaster/source-library.js"},
      {"from": "../../reference-data.js", "to": "mouldmaster/reference-data.js"},
      {"from": "../../reference-data.html", "to": "mouldmaster/reference-data.html"},
      {"from": "../../reference-deep-dive.js", "to": "mouldmaster/reference-deep-dive.js"},
      {"from": "../../reference-research-extension.js", "to": "mouldmaster/reference-research-extension.js"},
      {"from": "../../reference-20x-extension.js", "to": "mouldmaster/reference-20x-extension.js"},
      {"from": "../../reference-2026-expansion.js", "to": "mouldmaster/reference-2026-expansion.js"},
      {"from": "../../reference-sources.js", "to": "mouldmaster/reference-sources.js"},
      {"from": "../../reference-browser-ui.js", "to": "mouldmaster/reference-browser-ui.js"},
      {"from": "../../diagnostic-learning-labs.js", "to": "mouldmaster/diagnostic-learning-labs.js"},
      {"from": "../../material-behaviour-labs.js", "to": "mouldmaster/material-behaviour-labs.js"},
      {"from": "../../assessment-evidence-sources.js", "to": "mouldmaster/assessment-evidence-sources.js"},
      {"from": "../../assessment-evidence-approval.js", "to": "mouldmaster/assessment-evidence-approval.js"},
      {"from": "../../service-worker.js", "to": "mouldmaster/service-worker.js"},
      {"from": "../../privacy.html", "to": "mouldmaster/privacy.html"},
      {"from": "../../support.html", "to": "mouldmaster/support.html"},
      {"from": "../../LICENSE", "to": "LICENSE"},
      {"from": "../../THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md"},
      {"from": "generated/integrity.json", "to": "mouldmaster/integrity.json"},
      {"from": "generated/dependency-licenses.json", "to": "dependency-licenses.json"},
      {"from": "generated/sbom.cdx.json", "to": "sbom.cdx.json"}
    ],
    "win": {
      "icon": "../../mouldmaster-512.png",
      "artifactName": "MouldMaster-Academy-${buildVersion}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "toolsets": {"winCodeSign": "1.1.0"}
  }
}